{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "neverConnectToCloud": true,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/vitest.config.mts",
      "!{projectRoot}/transloco.config.ts"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/libs/tsconfig.*.base.json"
    ],
    "lintGlobals": [
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/eslint.angular.mjs",
      "{workspaceRoot}/eslint.module-boundaries.mjs",
      "{workspaceRoot}/tsconfig*.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/pnpm-lock.yaml"
    ],
    "workerLint": [
      "default",
      "{workspaceRoot}/apps/workers/eslint.config.mjs",
      "{workspaceRoot}/eslint.module-boundaries.mjs",
      {
        "externalDependencies": [
          "eslint",
          "@eslint/js",
          "eslint-config-prettier",
          "@nx/eslint-plugin",
          "typescript-eslint",
          "typescript"
        ]
      }
    ],
    "workerSource": [
      "{projectRoot}/**/*",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/vitest.config.mjs",
      "!{projectRoot}/tsconfig.json"
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "ciTargetName": "test-ci",
        "testMode": "watch"
      }
    }
  ],
  "targetDefaults": {
    "@angular/build:application": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production", "{workspaceRoot}/.postcssrc.json"]
    },
    "test": {
      "inputs": [
        "default",
        "{workspaceRoot}/vitest.angular.mts",
        "^production",
        {
          "env": "CI"
        }
      ]
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["workerSource"],
      "outputs": [],
      "options": {
        "command": "npx --yes wrangler@4.151.1 deploy --dry-run",
        "cwd": "{projectRoot}"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["check"],
      "options": {
        "command": "npx --yes wrangler@4.151.1 deploy --tag \"$(git rev-parse --short HEAD)\" --message \"$(git log -1 --format=%s | cut -c1-100)\"",
        "cwd": "{projectRoot}"
      },
      "inputs": ["workerSource"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "^default", "lintGlobals"],
      "options": {
        "max-warnings": 0
      }
    },
    "angular-typechecker:typecheck": {
      "cache": true,
      "options": {
        "tsConfig": "{projectRoot}/tsconfig.json"
      },
      "outputs": [],
      "inputs": [
        "default",
        "{projectRoot}/tsconfig*.json",
        "{projectRoot}/package.json",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/vitest.angular.mts",
        "^default",
        {
          "dependentTasksOutputFiles": "**/*.{d.ts,d.cts,d.mts,tsbuildinfo}",
          "transitive": true
        },
        {
          "externalDependencies": ["typescript", "@angular/compiler-cli"]
        }
      ]
    }
  },
  "generators": {
    "@nx/angular:application": {
      "e2eTestRunner": "playwright",
      "linter": "eslint",
      "style": "css",
      "unitTestRunner": "vitest-analog"
    },
    "@nx/angular:component": {
      "style": "css"
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "vitest-analog"
    }
  },
  "pluginsConfig": {
    "@nx/js": {
      "projectsAffectedByDependencyUpdates": "auto"
    }
  },
  "affected": {
    "legacy": true
  }
}
