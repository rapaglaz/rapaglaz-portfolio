{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 10am on monday"],
  "dependencyDashboardTitle": "Dependency Dashboard",
  "dependencyDashboardLabels": ["dependencies"],
  "labels": ["dependencies"],
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "prHourlyLimit": 3,
  "internalChecksFilter": "strict",
  "separateMajorMinor": true,
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 3am on the first day of the month"],
    "automerge": true
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "groupName": null,
    "minimumReleaseAge": "0 days",
    "schedule": ["at any time"],
    "vulnerabilityFixStrategy": "highest"
  },
  "packageRules": [
    {
      "description": "One weekly PR for all stable patch, digest and pin updates (patches automerged below)",
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["patch", "digest", "pin"],
      "groupName": "patch dependencies"
    },
    {
      "description": "Digest and pin updates have no release age to wait on: never automerge",
      "matchUpdateTypes": ["digest", "pin"],
      "automerge": false
    },
    {
      "description": "One weekly PR for all stable minor updates (merged manually)",
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["minor"],
      "groupName": "minor dependencies"
    },
    {
      "description": "Require approval for all major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "labels": ["major-update"]
    },
    {
      "description": "Automerge stable patch updates",
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Require approval for unstable 0.x updates",
      "matchCurrentVersion": "/^0/",
      "matchUpdateTypes": ["minor", "patch"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "labels": ["unstable-version"]
    },
    {
      "description": "Angular packages: update together (majors included, still approval-gated), no automerge, run ng update manually",
      "matchPackageNames": [
        "@angular/**",
        "@angular-devkit/**",
        "@schematics/angular",
        "@angular-eslint/**",
        "angular-eslint"
      ],
      "groupName": "angular",
      "automerge": false
    },
    {
      "description": "Nx packages must share one version: update together (majors included, still approval-gated), no automerge, run the Nx migrations manually",
      "matchPackageNames": ["nx", "@nx/**"],
      "groupName": "nx",
      "automerge": false,
      "prBodyNotes": [
        "Nx may ship migrations for this update. On this branch run `pnpm nx migrate <new version> --from=nx@<old version>`, then `pnpm nx migrate --run-migrations` if it created `migrations.json`. Commit the changes and delete `migrations.json`."
      ]
    },
    {
      "description": "Playwright installs its own browsers and system deps in CI: no automerge, a bump changes the E2E environment",
      "matchPackageNames": ["@playwright/test"],
      "groupName": "playwright",
      "automerge": false
    }
  ]
}
