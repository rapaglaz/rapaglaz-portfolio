{
  "name": "@rapaglaz-portfolio/source",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "nx serve rapaglaz-portfolio",
    "build": "nx build rapaglaz-portfolio",
    "watch": "nx build rapaglaz-portfolio --watch --configuration development",
    "test": "nx test rapaglaz-portfolio",
    "test:watch": "nx test rapaglaz-portfolio --watch",
    "test:ui": "nx test rapaglaz-portfolio --ui",
    "test:coverage": "nx test rapaglaz-portfolio --coverage",
    "test:workers": "vitest run --config workers/vitest.config.js",
    "workers:check": "for config in workers/*/wrangler.jsonc; do (cd \"$(dirname \"$config\")\" && npx --yes wrangler@4.151.1 deploy --dry-run) || exit 1; done",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "deps:check": "depcruise --config .dependency-cruiser.cjs --output-type err apps/rapaglaz-portfolio/src/app",
    "deps:graph": "mkdir -p tmp/dependency-cruiser && depcruise --config .dependency-cruiser.cjs --output-type html --output-to tmp/dependency-cruiser/dependencies.html apps/rapaglaz-portfolio/src/app",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "i18n:validate": "transloco-validator apps/rapaglaz-portfolio/public/i18n/*.json",
    "i18n:find": "transloco-keys-manager find",
    "i18n:check": "pnpm run i18n:validate && pnpm run i18n:find",
    "preview": "serve dist/apps/rapaglaz-portfolio/browser -l 4233",
    "e2e": "nx e2e rapaglaz-portfolio-e2e",
    "e2e:ui": "nx e2e rapaglaz-portfolio-e2e --ui",
    "e2e:ssg": "pnpm run build && E2E_MODE=ssg nx e2e rapaglaz-portfolio-e2e",
    "e2e:ssg:ui": "pnpm run build && E2E_MODE=ssg nx e2e rapaglaz-portfolio-e2e --ui",
    "clean": "rm -rf .angular && rm -rf .nx && rm -rf node_modules",
    "clean:reinstall": "pnpm run clean && pnpm install",
    "prepare": "[ -n \"$CI\" ] || lefthook install"
  },
  "dependencies": {
    "@angular/cdk": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-server": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/ssr": "22.2.3",
    "@fontsource/inter": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@jsverse/transloco": "8.4.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.8.1",
    "@analogjs/vitest-angular": "2.8.1",
    "@angular-devkit/core": "22.2.3",
    "@angular-devkit/schematics": "22.2.3",
    "@angular-eslint/builder": "22.6.0",
    "@angular-eslint/eslint-plugin": "22.6.0",
    "@angular-eslint/eslint-plugin-template": "22.6.0",
    "@angular-eslint/template-parser": "22.6.0",
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@jsverse/transloco-keys-manager": "8.1.1",
    "@jsverse/transloco-utils": "8.4.0",
    "@jsverse/transloco-validator": "8.4.0",
    "@nx/angular": "23.3.0",
    "@nx/devkit": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/playwright": "23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@oxc-project/runtime": "0.154.0",
    "@playwright/test": "1.64.1",
    "@schematics/angular": "22.2.3",
    "@swc/helpers": "0.5.23",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@typescript-eslint/utils": "8.71.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "angular-eslint": "22.6.0",
    "angular-typechecker": "0.2.4",
    "daisyui": "5.7.50",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-prettier": "5.5.7",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "lighthouse": "13.5.0",
    "lint-staged": "17.6.0",
    "nx": "23.3.0",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.0",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
