{
  "name": "@rapaglaz-portfolio/source",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "nx run-many -t serve -p rapaglaz-portfolio cv-download",
    "build": "nx build rapaglaz-portfolio",
    "watch": "nx build rapaglaz-portfolio --watch --configuration development",
    "test": "nx run-many -t test --exclude='tag:type:worker'",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "nx run-many -t test --exclude='tag:type:worker' --coverage",
    "test:workers": "nx run-many -t test -p tag:type:worker",
    "workers:check": "nx run-many -t check -p tag:type:worker",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "deps:check": "nx deps-check rapaglaz-portfolio",
    "deps:graph": "nx deps-graph rapaglaz-portfolio",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "i18n:validate": "transloco-validator libs/shared/util/src/lib/i18n/translations/*.json",
    "i18n:find": "transloco-keys-manager find -c apps/rapaglaz-portfolio/transloco.config.ts",
    "i18n:check": "pnpm run i18n:validate && pnpm run i18n:find",
    "preview": "serve dist/apps/rapaglaz-portfolio/browser -l 4233",
    "e2e": "nx e2e rapaglaz-portfolio-e2e",
    "e2e:ui": "nx e2e rapaglaz-portfolio-e2e --ui",
    "e2e:ssg": "pnpm run build && E2E_MODE=ssg nx e2e rapaglaz-portfolio-e2e",
    "e2e:ssg:ui": "pnpm run build && E2E_MODE=ssg nx e2e rapaglaz-portfolio-e2e --ui",
    "clean": "rm -rf .angular && rm -rf .nx && rm -rf node_modules",
    "clean:reinstall": "pnpm run clean && pnpm install",
    "prepare": "[ -n \"$CI\" ] || lefthook install"
  },
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-server": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/ssr": "22.2.4",
    "@fontsource/inter": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@jsverse/transloco": "8.4.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.9.2",
    "@analogjs/vitest-angular": "2.9.2",
    "@angular-devkit/core": "22.2.4",
    "@angular-devkit/schematics": "22.2.4",
    "@angular-eslint/builder": "22.6.0",
    "@angular-eslint/eslint-plugin": "22.6.0",
    "@angular-eslint/eslint-plugin-template": "22.6.0",
    "@angular-eslint/template-parser": "22.6.0",
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261024.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@jsverse/transloco-keys-manager": "8.1.1",
    "@jsverse/transloco-utils": "8.4.0",
    "@jsverse/transloco-validator": "8.4.0",
    "@nx/angular": "24.0.1",
    "@nx/devkit": "24.0.1",
    "@nx/eslint": "24.0.1",
    "@nx/eslint-plugin": "24.0.1",
    "@nx/js": "24.0.1",
    "@nx/playwright": "24.0.1",
    "@nx/vite": "24.0.1",
    "@nx/vitest": "24.0.1",
    "@nx/web": "24.0.1",
    "@nx/workspace": "24.0.1",
    "@oxc-project/runtime": "0.155.0",
    "@playwright/test": "1.64.1",
    "@schematics/angular": "22.2.4",
    "@swc/helpers": "0.5.23",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@typescript-eslint/utils": "8.72.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "angular-eslint": "22.6.0",
    "angular-typechecker": "0.2.4",
    "daisyui": "5.7.50",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "lighthouse": "13.5.0",
    "lint-staged": "17.6.0",
    "nx": "24.0.1",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.15.0"
}
