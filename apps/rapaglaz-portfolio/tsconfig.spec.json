{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // vitest.config.mts imports the shared factory with its .mts extension; specs are never emitted
    "rewriteRelativeImportExtensions": true,
    "outDir": "../../dist/out-tsc",
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"]
  },
  "include": ["vitest.config.mts", "transloco.config.ts", "src/**/*.spec.ts"],
  "files": ["src/test-setup.ts"]
}
