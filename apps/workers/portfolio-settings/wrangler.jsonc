// Source of truth for this Worker. Routes stay in the Cloudflare dashboard: with no route keys
// and workers_dev set to false, wrangler deploy leaves them unchanged. The compatibility date
// matches the active version on 2026-10-17 (wrangler versions view); it has no bindings.
{
  "name": "portfolio-settings",
  "main": "index.ts",
  "compatibility_date": "2025-10-31",
  "workers_dev": false,
  "preview_urls": false,
}
