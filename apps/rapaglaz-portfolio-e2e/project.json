{
  "name": "rapaglaz-portfolio-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/rapaglaz-portfolio-e2e/src",
  "tags": ["type:e2e"],
  "implicitDependencies": ["rapaglaz-portfolio"],
  "// targets": "to see all targets run: nx show project rapaglaz-portfolio-e2e --web",
  "targets": {
    "e2e": {
      "// dependsOn": "playwright.config.mts starts the dev server or the static build itself, depending on E2E_MODE and CI",
      "dependsOn": [],
      "// cache": "E2E_MODE and CI pick the dev server or the static build, so both are inputs",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/.postcssrc.json",
        { "env": "E2E_MODE" },
        { "env": "CI" },
        { "externalDependencies": ["@playwright/test"] }
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": [],
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc -p tsconfig.json --noEmit"
      }
    }
  }
}
